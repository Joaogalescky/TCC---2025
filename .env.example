# Backend
DATABASE_URL=sqlite+aiosqlite:///database.db
# Gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=troque-por-uma-chave-secreta
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Administrador (criado ao iniciar o backend, se ainda não existir)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=troque-esta-senha

# Criptografia
PLAINTEXT_MODULUS=65537
MULTIPLICATIVE_DEPTH=2

# Lotes de votos: ao completar LOTE_TAMANHO votos o lote é fechado num subtotal
# cifrado; nenhum conjunto parcial (nem o complemento) com menos de
# LOTE_MINIMO_DECIFRAR votos pode ser decifrado
LOTE_TAMANHO=1000
LOTE_MINIMO_DECIFRAR=100
# Pasta das chaves do OpenFHE (no Docker, volume eleicao_keys)
KEYS_DIR=/app/keys

# Frontend
ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
